---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import { supportedLang, withBasePath } from "@/lib/utils/languageParser";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import Testimonial from "@/partials/Testimonial.astro";
import type { Feature } from "@/types";
import type { ContentEntryMap } from "astro:content";
import { FaArrowRight, FaAtom, FaCheck, FaFlask, FaStar } from "react-icons/fa";

export function getStaticPaths() {
  return supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
}

const { lang } = Astro.params;
const homepage = await getListPage("homepage", lang as keyof ContentEntryMap);
const { banner, features } = homepage[0].data;
const testimonial = await getSinglePage(
  "sections",
  lang as keyof ContentEntryMap,
  "testimonial"
);
const call_to_action = await getSinglePage(
  "sections",
  lang as keyof ContentEntryMap,
  "call-to-action"
);

const normalizeLink = (link: string) =>
  link.startsWith("/") ? withBasePath(link) : link;

const featureButtons = (feature: Feature) =>
  [
    feature.button,
    feature.button2,
    feature.button3,
    feature.button4,
    feature.button5,
  ].filter((button) => button?.enable);

const sectionCodes = ["01 / DESIGN", "02 / PEOPLE", "03 / OUTPUT", "04 / INFRA", "05 / JOIN"];
---

<Base>
  <div class="epoch-page">
    <section class="epoch-hero" aria-labelledby="preview-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="orb orb-a" aria-hidden="true"></div>
      <div class="orb orb-b" aria-hidden="true"></div>
      <div class="orb orb-c" aria-hidden="true"></div>
      <div class="signal signal-a" aria-hidden="true"></div>
      <div class="signal signal-b" aria-hidden="true"></div>

      <div class="container relative z-10">
        <div class="preview-kicker">
          <span class="pulse-dot"></span>
          <span>NON-OFFICIAL / EXPERIMENTAL INTERFACE / 2026</span>
        </div>

        <div class="hero-layout">
          <div class="hero-copy">
            <p class="hero-overline">NANO MATERIALS DESIGN LABORATORY</p>
            <h1 id="preview-title">DESIGN<br /><em>THE</em> IMPOSSIBLE.</h1>
            <div class="hero-rule"></div>
            <div class="hero-content" set:html={markdownify(banner.content)} />
            <div class="hero-actions">
              {
                banner.button.enable && (
                  <a
                    class="hero-cta"
                    href={normalizeLink(banner.button.link)}
                    target={banner.button.link.startsWith("http") ? "_blank" : "_self"}
                    rel="noopener"
                  >
                    <span>{banner.button.label}</span>
                    <FaArrowRight />
                  </a>
                )
              }
              <a class="hero-secondary" href="#laboratory-map">EXPLORE THE LAB <FaAtom /></a>
            </div>
          </div>

          <div class="hero-visual">
            <div class="image-frame">
              {
                banner.image && (
                  <ImageMod
                    src={banner.image}
                    height={680}
                    width={1200}
                    alt="Nano Materials Design Laboratory preview"
                    format="webp"
                  />
                )
              }
              <div class="image-scan" aria-hidden="true"></div>
              <div class="image-label image-label-top">NMDL // TOKYO // 35.6664° N</div>
              <div class="image-label image-label-bottom">MATERIALS ARE NOT FOUND．THEY ARE COMPOSED．</div>
            </div>
            <div class="hero-stamp" aria-label="Preview mode">
              <span>PREVIEW</span>
              <span>PREVIEW</span>
              <span>PREVIEW</span>
            </div>
          </div>
        </div>

        <div class="hero-metrics" aria-label="Laboratory design principles">
          <div><strong>AI</strong><span>atomistic intelligence</span></div>
          <div><strong>×</strong><span>physical measurement</span></div>
          <div><strong>∞</strong><span>designed possibilities</span></div>
          <div class="metrics-marker"><FaFlask /> LIVE EXPERIMENTAL LAYOUT</div>
        </div>
      </div>
    </section>

    <section class="marquee-band" aria-label="Research themes">
      <div class="marquee-track">
        <span>COMPUTATION</span><b>✦</b><span>CHARACTERIZATION</span><b>✦</b><span>PHYSICAL AI</span><b>✦</b><span>DESIGNED MATERIALS</span><b>✦</b>
        <span>COMPUTATION</span><b>✦</b><span>CHARACTERIZATION</span><b>✦</b><span>PHYSICAL AI</span><b>✦</b><span>DESIGNED MATERIALS</span><b>✦</b>
      </div>
    </section>

    <section class="manifesto section" aria-labelledby="manifesto-title">
      <div class="container">
        <div class="manifesto-grid">
          <div class="manifesto-index">
            <span>00</span>
            <p>THE<br />MANIFESTO</p>
          </div>
          <div class="manifesto-copy">
            <p class="eyebrow"><FaStar /> A LABORATORY AS A LAUNCHPAD</p>
            <h2 id="manifesto-title">Not a catalogue of research．<br /><em>A machine for making futures．</em></h2>
            <p>
              The preview retains every route and every core message of the official NMDL site，but stages them as a bolder research interface：one that treats materials science as a collision between atoms，algorithms，instruments，and human curiosity．
            </p>
          </div>
          <div class="manifesto-note">
            <span class="note-number">NMDL / 01</span>
            <p>Scroll through five active vectors of the laboratory．Every destination below remains connected to its original full page．</p>
          </div>
        </div>
      </div>
    </section>

    <section id="laboratory-map" class="laboratory-map" aria-labelledby="map-title">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">LABORATORY MAP / FULL SITE ACCESS</p>
            <h2 id="map-title">Five vectors．<br /><em>One material universe．</em></h2>
          </div>
          <p class="section-sidecopy">All original research，team，achievement，environment，and recruitment content remains here－reframed as an experimental navigation system．</p>
        </div>

        <div class="vector-list">
          {
            features.map((feature: Feature, index: number) => (
              <article class={`vector vector-${index + 1}`}>
                <div class="vector-number">{String(index + 1).padStart(2, "0")}</div>
                <div class="vector-content">
                  <p class="vector-code">{sectionCodes[index] ?? `0${index + 1} / NMDL`}</p>
                  <h3 set:html={markdownify(feature.title)} />
                  <p class="vector-subtitle" set:html={markdownify(feature.content)} />
                  <ul class="vector-points">
                    {feature.bulletpoints.map((bullet: string) => (
                      <li><FaCheck /><span set:html={markdownify(bullet)} /></li>
                    ))}
                  </ul>
                  <div class="vector-links">
                    {featureButtons(feature).map((button) => (
                      <a href={normalizeLink(button.link)}>
                        <span>{button.label}</span><FaArrowRight />
                      </a>
                    ))}
                  </div>
                </div>
                <div class="vector-image">
                  <ImageMod
                    src={feature.image}
                    height={420}
                    width={680}
                    alt={feature.title}
                    format="webp"
                  />
                  <span class="image-coordinate">{String(37 + index * 11).padStart(3, "0")}° // ACTIVE VECTOR</span>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="interlude" aria-label="NMDL statement">
      <div class="interlude-orbit orbit-one" aria-hidden="true"></div>
      <div class="interlude-orbit orbit-two" aria-hidden="true"></div>
      <p>ATOMS<br />ARE <span>ARGUMENTS．</span></p>
      <small>WE TEST THEM AGAINST REALITY．</small>
    </section>

    <div class="proof-zone">
      <Testimonial testimonial={testimonial[0]} />
    </div>

    <section class="preview-disclaimer">
      <div class="container">
        <div class="disclaimer-inner">
          <div><span class="pulse-dot"></span> EXPERIMENTAL PREVIEW</div>
          <p>This is a deliberately high-voltage visual experiment．The official NMDL content，links，and information architecture remain available throughout the preview．</p>
          <a href="https://nmdl-mizo.github.io/" target="_blank" rel="noopener">OFFICIAL SITE <FaArrowRight /></a>
        </div>
      </div>
    </section>

    <CallToAction call_to_action={call_to_action[0]} />
  </div>
</Base>

<style lang="scss">
  :global(body) {
    background: #f1f0eb;
    color: #151518;
  }

  :global(.epoch-page) {
    overflow: clip;
  }

  .epoch-hero {
    position: relative;
    min-height: min(900px, 92vh);
    overflow: hidden;
    background: #141318;
    color: #fff8eb;
    isolation: isolate;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0.3;
    background-image: linear-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.16) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(circle at 70% 40%, black 0%, transparent 65%);
  }

  .orb {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    filter: blur(1px);
    mix-blend-mode: screen;
  }

  .orb-a { width: 35rem; height: 35rem; right: -9rem; top: -11rem; background: #e6ff39; opacity: .86; animation: float-orb 11s ease-in-out infinite alternate; }
  .orb-b { width: 24rem; height: 24rem; left: -7rem; bottom: -7rem; background: #fd4b90; opacity: .78; animation: float-orb 9s ease-in-out infinite alternate-reverse; }
  .orb-c { width: 17rem; height: 17rem; right: 31%; bottom: -12rem; background: #43f0ff; opacity: .8; animation: float-orb 13s ease-in-out infinite alternate; }

  .signal { position: absolute; z-index: -1; height: 2px; width: 120vw; transform: rotate(-16deg); background: #fff8eb; box-shadow: 0 0 22px #fff8eb; opacity: .7; }
  .signal-a { top: 28%; left: -20%; }
  .signal-b { top: 72%; left: -10%; transform: rotate(22deg); background: #e6ff39; box-shadow: 0 0 24px #e6ff39; }

  .preview-kicker { display: inline-flex; align-items: center; gap: .7rem; margin-top: 2.1rem; padding: .54rem .9rem; border: 1px solid rgba(255,255,255,.46); font-family: var(--font-primary); font-size: .67rem; font-weight: 800; letter-spacing: .16em; }
  .pulse-dot { display: inline-block; width: .55rem; height: .55rem; border-radius: 50%; background: #e6ff39; box-shadow: 0 0 0 0 rgba(230,255,57,.7); animation: pulse 1.7s infinite; }

  .hero-layout { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(330px, .95fr); align-items: center; gap: 3rem; padding: 5.6rem 0 3.5rem; }
  .hero-copy { position: relative; z-index: 2; }
  .hero-overline, .eyebrow, .vector-code { font-family: var(--font-primary); font-size: .72rem; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; }
  .hero-overline { color: #e6ff39; }
  .hero-copy h1 { margin: 1rem 0 1.2rem; font-family: var(--font-secondary); font-size: clamp(3.4rem, 8vw, 8.4rem); line-height: .78; letter-spacing: -.08em; color: #fff8eb; text-transform: uppercase; }
  .hero-copy h1 em { color: #fd4b90; font-style: normal; -webkit-text-stroke: 1px #fff8eb; }
  .hero-rule { width: min(100%, 31rem); height: 8px; margin: 1.9rem 0; background: repeating-linear-gradient(90deg, #43f0ff 0 20px, transparent 20px 31px); }
  .hero-content { max-width: 42rem; font-size: 1.08rem; line-height: 1.72; color: rgba(255,248,235,.89); }
  .hero-content :global(p) { margin: 0 0 .85rem; }
  .hero-content :global(a) { color: #e6ff39; text-decoration: underline; text-underline-offset: 4px; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; margin-top: 2rem; }
  .hero-cta, .hero-secondary { display: inline-flex; align-items: center; justify-content: center; gap: .85rem; font-family: var(--font-primary); font-size: .75rem; font-weight: 800; letter-spacing: .1em; transition: transform .22s ease, background .22s ease; }
  .hero-cta { padding: 1rem 1.25rem; background: #e6ff39; color: #141318; }
  .hero-cta:hover { color: #141318; transform: translate(4px,-4px); box-shadow: -5px 5px 0 #fd4b90; }
  .hero-secondary { color: #fff8eb; border-bottom: 1px solid #fff8eb; padding-bottom: .22rem; }
  .hero-secondary:hover { color: #43f0ff; border-color: #43f0ff; }

  .hero-visual { position: relative; }
  .image-frame { position: relative; min-height: 490px; border: 2px solid #fff8eb; background: #29262e; transform: rotate(2.4deg); box-shadow: 18px 18px 0 #fd4b90, -12px -12px 0 #43f0ff; overflow: hidden; }
  .image-frame :global(img) { display: block; width: 100%; height: 100%; min-height: 490px; object-fit: cover; filter: contrast(1.15) saturate(.72) hue-rotate(332deg); }
  .image-frame::after { content: ""; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(230,255,57,.23), transparent 42%, rgba(253,75,144,.3)); mix-blend-mode: screen; pointer-events: none; }
  .image-scan { position: absolute; inset: 0; z-index: 2; background: repeating-linear-gradient(180deg, rgba(255,255,255,.08) 0 1px, transparent 1px 5px); pointer-events: none; }
  .image-label { position: absolute; z-index: 3; left: .85rem; right: .85rem; font-family: var(--font-primary); font-size: .58rem; font-weight: 800; letter-spacing: .13em; color: #fff8eb; }
  .image-label-top { top: .8rem; }
  .image-label-bottom { bottom: .8rem; }
  .hero-stamp { position: absolute; right: -2.7rem; bottom: -1.7rem; display: grid; place-content: center; width: 9rem; height: 9rem; border-radius: 50%; background: #e6ff39; color: #141318; font-family: var(--font-primary); font-size: .85rem; font-weight: 900; letter-spacing: .04em; line-height: 1.05; text-align: center; transform: rotate(-17deg); box-shadow: 0 0 0 8px #141318; }

  .hero-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-top: 1rem; border: 1px solid rgba(255,248,235,.5); background: rgba(255,248,235,.34); }
  .hero-metrics > div { display: flex; min-height: 5.2rem; flex-direction: column; justify-content: center; padding: .8rem 1rem; background: rgba(20,19,24,.88); }
  .hero-metrics strong { font-family: var(--font-secondary); font-size: 2rem; line-height: 1; color: #e6ff39; }
  .hero-metrics span, .metrics-marker { font-family: var(--font-primary); font-size: .59rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .hero-metrics .metrics-marker { flex-direction: row; align-items: center; gap: .55rem; color: #141318; background: #fff8eb; }

  .marquee-band { overflow: hidden; padding: 1rem 0; background: #e6ff39; color: #141318; white-space: nowrap; }
  .marquee-track { display: flex; width: max-content; align-items: center; gap: 1.4rem; font-family: var(--font-secondary); font-size: 1.1rem; font-weight: 900; letter-spacing: .06em; animation: marquee 28s linear infinite; }
  .marquee-track b { color: #fd4b90; font-size: 1.4rem; }

  .manifesto { position: relative; padding: 8.5rem 0; background: #f1f0eb; }
  .manifesto::before { content: "NMDL"; position: absolute; right: -2rem; top: -.42em; color: rgba(20,19,24,.05); font-family: var(--font-secondary); font-size: clamp(9rem, 25vw, 28rem); font-weight: 900; line-height: 1; pointer-events: none; }
  .manifesto-grid { position: relative; display: grid; grid-template-columns: .6fr 2fr .8fr; gap: 3rem; }
  .manifesto-index { display: flex; flex-direction: column; align-items: flex-start; gap: .7rem; color: #141318; }
  .manifesto-index span { font-family: var(--font-secondary); font-size: 4rem; font-weight: 900; line-height: .8; color: #fd4b90; }
  .manifesto-index p { margin: 0; font-family: var(--font-primary); font-size: .62rem; font-weight: 800; letter-spacing: .13em; line-height: 1.5; }
  .eyebrow { display: flex; align-items: center; gap: .5rem; color: #8d2773; }
  .manifesto-copy h2, .section-head h2 { margin: .85rem 0 1.5rem; font-family: var(--font-secondary); font-size: clamp(2.5rem, 5vw, 5.5rem); font-weight: 900; line-height: .88; letter-spacing: -.06em; }
  .manifesto-copy h2 em, .section-head h2 em { color: #8d2773; font-style: normal; }
  .manifesto-copy > p:last-child { max-width: 44rem; font-size: 1.12rem; line-height: 1.75; }
  .manifesto-note { align-self: end; border-left: 4px solid #43c3c7; padding: 1rem 0 1rem 1.1rem; }
  .note-number { font-family: var(--font-primary); font-size: .63rem; font-weight: 900; letter-spacing: .14em; }
  .manifesto-note p { margin: .6rem 0 0; font-size: .88rem; line-height: 1.55; }

  .laboratory-map { position: relative; padding: 7rem 0 8rem; background: #17151d; color: #fff8eb; }
  .laboratory-map::before { content: "VECTOR FIELD"; position: absolute; top: 1rem; left: -2rem; color: rgba(255,255,255,.04); font-family: var(--font-secondary); font-size: clamp(5rem, 16vw, 15rem); font-weight: 900; white-space: nowrap; }
  .section-head { position: relative; display: grid; grid-template-columns: 1.55fr .65fr; gap: 3rem; align-items: end; margin-bottom: 4rem; }
  .section-head .eyebrow { color: #e6ff39; }
  .section-head h2 { color: #fff8eb; }
  .section-head h2 em { color: #43f0ff; }
  .section-sidecopy { margin: 0; max-width: 22rem; font-size: .94rem; line-height: 1.6; color: rgba(255,248,235,.76); }
  .vector-list { position: relative; border-top: 1px solid rgba(255,248,235,.4); }
  .vector { display: grid; grid-template-columns: 6rem minmax(0, 1.25fr) minmax(210px, .75fr); gap: 2rem; align-items: center; min-height: 26rem; padding: 2.5rem 0; border-bottom: 1px solid rgba(255,248,235,.4); transition: background .3s ease, padding .3s ease; }
  .vector:hover { margin: 0 -1.2rem; padding-right: 1.2rem; padding-left: 1.2rem; background: rgba(255,255,255,.07); }
  .vector-number { align-self: start; font-family: var(--font-secondary); font-size: 3.3rem; font-weight: 900; line-height: .8; color: #e6ff39; }
  .vector-content h3 { margin: .35rem 0 .3rem; color: #fff8eb; font-family: var(--font-secondary); font-size: clamp(2rem, 4vw, 4.4rem); font-weight: 900; line-height: .86; letter-spacing: -.06em; }
  .vector-subtitle { margin: 0 0 1.2rem; color: #43f0ff; font-family: var(--font-primary); font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .vector-points { margin: 0; padding: 0; list-style: none; }
  .vector-points li { display: flex; gap: .75rem; margin: .55rem 0; color: rgba(255,248,235,.82); font-size: .92rem; line-height: 1.58; }
  .vector-points svg { flex: none; margin-top: .28rem; color: #fd4b90; }
  .vector-links { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.45rem; }
  .vector-links a { display: inline-flex; align-items: center; gap: .45rem; border: 1px solid rgba(255,248,235,.65); padding: .47rem .66rem; color: #fff8eb; font-family: var(--font-primary); font-size: .63rem; font-weight: 800; letter-spacing: .07em; transition: all .2s ease; }
  .vector-links a:hover { border-color: #e6ff39; background: #e6ff39; color: #141318; transform: translateY(-3px); }
  .vector-image { position: relative; overflow: hidden; border: 1px solid rgba(255,248,235,.8); background: #302d38; }
  .vector-image :global(img) { display: block; width: 100%; min-height: 250px; object-fit: cover; filter: saturate(.4) contrast(1.17); transition: transform .55s ease, filter .55s ease; }
  .vector:hover .vector-image :global(img) { filter: saturate(1.18) contrast(1.1); transform: scale(1.08); }
  .vector-image::after { content: ""; position: absolute; inset: 0; border: 8px solid rgba(230,255,57,.44); mix-blend-mode: screen; pointer-events: none; }
  .vector-2 .vector-number, .vector-2 .vector-code { color: #fd4b90; }
  .vector-2 .vector-image::after { border-color: rgba(253,75,144,.55); }
  .vector-3 .vector-number, .vector-3 .vector-code { color: #43f0ff; }
  .vector-3 .vector-image::after { border-color: rgba(67,240,255,.55); }
  .vector-4 .vector-number, .vector-4 .vector-code { color: #ff9e38; }
  .vector-4 .vector-image::after { border-color: rgba(255,158,56,.55); }
  .vector-5 .vector-number, .vector-5 .vector-code { color: #c99cff; }
  .vector-5 .vector-image::after { border-color: rgba(201,156,255,.55); }
  .image-coordinate { position: absolute; z-index: 2; right: .55rem; bottom: .55rem; padding: .28rem .4rem; background: #141318; color: #fff8eb; font-family: var(--font-primary); font-size: .49rem; font-weight: 800; letter-spacing: .09em; }

  .interlude { position: relative; display: grid; min-height: 32rem; place-content: center; overflow: hidden; background: #fd4b90; color: #141318; text-align: center; isolation: isolate; }
  .interlude p { position: relative; z-index: 1; margin: 0; font-family: var(--font-secondary); font-size: clamp(3.8rem, 10vw, 10rem); font-weight: 900; line-height: .78; letter-spacing: -.09em; }
  .interlude p span { color: #fff8eb; -webkit-text-stroke: 1px #141318; }
  .interlude small { position: relative; z-index: 1; margin-top: 1.9rem; font-family: var(--font-primary); font-size: .72rem; font-weight: 900; letter-spacing: .2em; }
  .interlude-orbit { position: absolute; top: 50%; left: 50%; border: 2px solid #141318; border-radius: 50%; opacity: .8; }
  .orbit-one { width: 45rem; height: 13rem; transform: translate(-50%,-50%) rotate(-18deg); }
  .orbit-two { width: 28rem; height: 28rem; transform: translate(-50%,-50%) rotate(42deg); border-color: #fff8eb; }

  .proof-zone { background: #f1f0eb; }
  :global(.proof-zone .section) { margin: 0; }

  .preview-disclaimer { padding: 1.35rem 0; background: #43f0ff; color: #141318; }
  .disclaimer-inner { display: grid; grid-template-columns: .8fr 2.1fr auto; gap: 1.5rem; align-items: center; font-family: var(--font-primary); font-size: .67rem; font-weight: 800; letter-spacing: .08em; }
  .disclaimer-inner > div, .disclaimer-inner a { display: inline-flex; align-items: center; gap: .5rem; }
  .disclaimer-inner p { margin: 0; line-height: 1.45; }
  .disclaimer-inner a { color: #141318; border-bottom: 1px solid #141318; padding-bottom: .15rem; white-space: nowrap; }

  @keyframes marquee { to { transform: translateX(-50%); } }
  @keyframes pulse { 70% { box-shadow: 0 0 0 8px rgba(230,255,57,0); } 100% { box-shadow: 0 0 0 0 rgba(230,255,57,0); } }
  @keyframes float-orb { to { transform: translate3d(2rem, 3rem, 0) scale(1.12); } }

  @media (max-width: 991px) {
    .hero-layout, .section-head { grid-template-columns: 1fr; }
