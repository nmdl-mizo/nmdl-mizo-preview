---
const lab = "/nmdl-mizo-preview";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050509" />
    <title>MACE-SAN // PLAYGROUND</title>
    <meta name="description" content="MACE-SAN experimental playground — materials, atoms, and impossible ideas." />
  </head>
  <body>
    <main>
      <div class="noise"></div>
      <div class="grid"></div>
      <div class="orb orb-a"></div><div class="orb orb-b"></div><div class="orb orb-c"></div>

      <nav>
        <a class="brand" href={`${lab}/`} aria-label="NMDL preview home"><span>◆</span> NMDL / MACE-SAN</a>
        <div class="nav-right"><span class="status"><i></i> SYSTEM: ALIVE</span><a href="#enter">ENTER ↗</a></div>
      </nav>

      <section class="hero" id="enter">
        <p class="eyebrow">MATERIALS INTELLIGENCE / 2026 / TOKYO</p>
        <h1><span>MACE</span><em>—SAN</em></h1>
        <p class="lead">原子を読み，結晶を妄想し，<br />まだ名前のない物質へ先回りする．</p>
        <div class="hero-bottom">
          <a class="launch" href="#vectors">PLAY THE FUTURE <b>↓</b></a>
          <p>非公式・実験的・<br />過剰に本気な遊び場．</p>
        </div>
      </section>

      <div class="ticker" aria-hidden="true"><div>ATOMISTIC AI ✦ MACE ✦ CRYSTAL DREAMING ✦ HIGH PRESSURE ✦ MACHINE LEARNING POTENTIALS ✦ ATOMISTIC AI ✦ MACE ✦ CRYSTAL DREAMING ✦ HIGH PRESSURE ✦ </div></div>

      <section class="manifesto">
        <p class="section-tag">// 00 : MANIFESTO</p>
        <h2>研究は，<br /><span>まだ見ぬ相</span>を<br />遊び倒すこと．</h2>
        <p class="copy">ここは論文の余白ではない．計算，直感，失敗，そして異常に美しいプロットが衝突して，新しい材料の輪郭が立ち上がる地点．MACE-SAN は，その衝突を楽しむための実験装置です．</p>
      </section>

      <section class="vectors" id="vectors">
        <div class="vectors-head"><p class="section-tag">// 01 : FIVE VECTORS</p><p>CLICK NOTHING．<br />FEEL EVERYTHING．</p></div>
        <div class="cards">
          <a href={`${lab}/research/`} class="card lime"><span>01</span><h3>ATOM<br />FEVER</h3><p>原子スケールの熱狂．</p><b>→</b></a>
          <a href={`${lab}/research/`} class="card magenta"><span>02</span><h3>AI<br />ALCHEMY</h3><p>潜在空間から物性へ．</p><b>→</b></a>
          <a href={`${lab}/research/`} class="card cyan"><span>03</span><h3>CRYSTAL<br />RIOT</h3><p>結晶構造に反乱を．</p><b>→</b></a>
          <a href={`${lab}/environment/`} class="card white"><span>04</span><h3>PLANET<br />MODE</h3><p>地球のための物質設計．</p><b>→</b></a>
          <a href={`${lab}/join/`} class="card dark"><span>05</span><h3>JOIN THE<br />WEIRD</h3><p>変な未来を一緒につくる．</p><b>→</b></a>
        </div>
      </section>

      <section class="signal">
        <div class="signal-art"><div class="atom"><i></i><i></i><i></i><strong></strong></div><p>MODEL<br />THINKING</p></div>
        <div><p class="section-tag">// 02 : SIGNAL DETECTED</p><h2>計算機の中に，<br />新しい自然をつくる．</h2><p class="copy">MACE をはじめとする機械学習原子間ポテンシャルは，単なる高速化ではない．探索の速度を，想像の速度まで引き上げる．</p><a class="text-link" href={`${lab}/research/`}>RESEARCH ARCHIVE <span>↗</span></a></div>
      </section>

      <section class="closing">
        <p class="section-tag">// FINAL TRANSMISSION</p>
        <h2>MAKE<br /><span>MATERIALS</span><br />MATTER.</h2>
        <a class="big-button" href={`${lab}/`}>NMDL PREVIEW SITE <span>↗</span></a>
      </section>

      <footer><span>© NMDL / MACE-SAN PLAYGROUND</span><span>DESIGNED AT THE EDGE OF THE PHASE DIAGRAM</span><span>東京大学・物性研究所（たぶん）</span></footer>
    </main>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;700;900&display=swap');
  :global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#050509;color:#f6f4ed;font-family:"Noto Sans JP",sans-serif;overflow-x:hidden}.noise{position:fixed;inset:0;z-index:20;pointer-events:none;opacity:.08;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E")}.grid{position:absolute;top:0;right:0;width:58vw;height:800px;opacity:.12;background-image:linear-gradient(#93ff00 1px,transparent 1px),linear-gradient(90deg,#93ff00 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,black,transparent);transform:perspective(500px) rotateX(58deg) translateY(-130px);transform-origin:top}.orb{position:absolute;border-radius:50%;filter:blur(1px);mix-blend-mode:screen;opacity:.9}.orb-a{width:30vw;height:30vw;right:-10vw;top:120px;background:#d600ff;filter:blur(70px)}.orb-b{width:22vw;height:22vw;left:-6vw;top:520px;background:#00edff;filter:blur(90px)}.orb-c{width:16vw;height:16vw;right:18vw;top:950px;background:#a8ff00;filter:blur(90px)}nav{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;padding:28px 4.5vw;font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.06em}.brand{color:#f6f4ed;text-decoration:none;font-weight:700}.brand span{color:#a8ff00;font-size:16px}.nav-right{display:flex;align-items:center;gap:28px}.nav-right a{color:#f6f4ed;text-decoration:none;border-bottom:1px solid #a8ff00;padding-bottom:3px}.status{color:#a8ff00}.status i{display:inline-block;width:7px;height:7px;background:#a8ff00;border-radius:50%;box-shadow:0 0 12px #a8ff00;margin-right:5px}.hero{position:relative;z-index:1;min-height:690px;padding:12vh 8vw 8vh;display:flex;flex-direction:column;justify-content:center}.eyebrow,.section-tag{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.13em;color:#a8ff00;margin:0 0 20px}.hero h1,.manifesto h2,.signal h2,.closing h2{font-family:"Archivo Black","Noto Sans JP",sans-serif;line-height:.78;letter-spacing:-.08em;margin:0}.hero h1{font-size:clamp(5.5rem,16vw,16rem)}.hero h1 span{display:block;color:#a8ff00;text-shadow:8px 8px 0 #d600ff}.hero h1 em{display:block;font-style:normal;margin-left:17vw;color:#f6f4ed}.lead{font-size:clamp(1rem,1.65vw,1.4rem);font-weight:700;line-height:1.8;margin:42px 0}.hero-bottom{display:flex;gap:48px;align-items:center;font-family:"IBM Plex Mono",monospace;font-size:11px}.hero-bottom p{color:#a7a5a2;line-height:1.7}.launch{background:#a8ff00;color:#050509;padding:16px 21px;text-decoration:none;font-weight:bold;transition:transform .2s}.launch:hover{transform:rotate(-3deg) scale(1.05)}.launch b{margin-left:20px;font-size:18px}.ticker{overflow:hidden;border-top:1px solid #f6f4ed;border-bottom:1px solid #f6f4ed;background:#d600ff;color:#050509;font-family:"Archivo Black",sans-serif;font-size:20px;white-space:nowrap;transform:rotate(-1.5deg) scale(1.03);position:relative;z-index:2}.ticker div{display:inline-block;padding:12px 0;animation:slide 25s linear infinite}@keyframes slide{to{transform:translateX(-50%)}}.manifesto,.vectors,.signal,.closing{position:relative;z-index:1;padding:150px 8vw}.manifesto{display:grid;grid-template-columns:1fr 2.3fr 1.1fr;gap:35px;align-items:start}.manifesto h2,.signal h2{font-size:clamp(3.2rem,7vw,7rem)}.manifesto h2 span{color:#d600ff}.copy{font-size:15px;line-height:2;color:#c5c2bc;margin:0}.vectors{background:#f6f4ed;color:#050509;padding-top:110px}.vectors .section-tag{color:#050509}.vectors-head{display:flex;justify-content:space-between;align-items:flex-start;font-family:"IBM Plex Mono",monospace;font-size:11px}.vectors-head>p:last-child{text-align:right;line-height:1.6}.cards{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:70px}.card{height:350px;padding:18px;display:flex;flex-direction:column;position:relative;text-decoration:none;color:#050509;transition:transform .25s,box-shadow .25s}.card:hover{transform:translateY(-14px) rotate(-1deg);box-shadow:10px 12px 0 #050509}.card span,.card p{font-family:"IBM Plex Mono",monospace;font-size:11px}.card h3{font-family:"Archivo Black",sans-serif;font-size:clamp(1.6rem,2.8vw,3rem);line-height:.88;letter-spacing:-.07em;margin:auto 0 14px}.card p{margin:0}.card b{font-size:28px;position:absolute;bottom:15px;right:18px}.lime{background:#a8ff00}.magenta{background:#d600ff}.cyan{background:#00e9ff}.white{background:#fff}.dark{background:#050509;color:#f6f4ed}.signal{display:grid;grid-template-columns:1fr 1fr;gap:10vw;align-items:center;min-height:680px}.signal h2{margin-bottom:34px}.signal-art{height:450px;border:1px solid #a8ff00;position:relative;display:flex;justify-content:center;align-items:center;overflow:hidden}.signal-art:before,.signal-art:after{content:"";position:absolute;width:140%;height:1px;background:#a8ff00;opacity:.4;transform:rotate(33deg)}.signal-art:after{transform:rotate(-47deg)}.signal-art p{position:absolute;bottom:18px;left:18px;font-family:"Archivo Black",sans-serif;font-size:34px;line-height:.85;color:#a8ff00;margin:0}.atom{width:240px;height:240px;position:relative;animation:spin 18s linear infinite}.atom strong{position:absolute;width:50px;height:50px;border-radius:50%;background:#d600ff;left:95px;top:95px;box-shadow:0 0 50px #d600ff}.atom i{position:absolute;inset:20px;border:2px solid #00e9ff;border-radius:50%;transform:rotate(55deg)}.atom i:nth-child(2){transform:rotate(115deg);border-color:#a8ff00}.atom i:nth-child(3){transform:rotate(0deg);border-color:#f6f4ed}@keyframes spin{to{transform:rotate(360deg)}}.text-link{display:inline-block;color:#a8ff00;text-decoration:none;font-family:"IBM Plex Mono",monospace;font-size:12px;margin-top:45px;border-bottom:1px solid #a8ff00;padding-bottom:8px}.text-link span{font-size:18px;margin-left:12px}.closing{background:linear-gradient(130deg,#d600ff 0%,#d600ff 37%,#00e9ff 37%,#00e9ff 100%);color:#050509;min-height:700px;padding-top:120px}.closing .section-tag{color:#050509}.closing h2{font-size:clamp(4rem,11vw,12rem);line-height:.78}.closing h2 span{color:#f6f4ed;text-shadow:7px 7px 0 #050509}.big-button{display:inline-flex;align-items:center;gap:50px;background:#050509;color:#a8ff00;padding:20px 24px;margin-top:65px;text-decoration:none;font-family:"IBM Plex Mono",monospace;font-size:12px}.big-button span{font-size:25px}footer{background:#050509;color:#aaa;display:flex;justify-content:space-between;gap:20px;padding:25px 4.5vw;font-family:"IBM Plex Mono",monospace;font-size:9px;letter-spacing:.05em}
  @media(max-width:800px){nav{padding:20px}.status{display:none}.hero{min-height:640px;padding:14vh 7vw}.hero h1{font-size:24vw}.hero h1 em{margin-left:8vw}.manifesto,.signal{display:block;padding:90px 7vw}.manifesto .section-tag{margin-bottom:35px}.manifesto h2{margin-bottom:30px}.vectors,.closing{padding:80px 7vw}.cards{grid-template-columns:1fr 1fr;margin-top:40px}.card{height:240px}.card:last-child{grid-column:span 2}.vectors-head{display:block}.vectors-head>p:last-child{text-align:left;margin-top:20px}.signal-art{height:340px;margin-bottom:60px}.closing{min-height:500px}footer{display:block;line-height:2.2}.orb-a{width:65vw;height:65vw}.hero-bottom{gap:20px}.ticker{font-size:15px}}
</style>
